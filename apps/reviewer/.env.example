# =============================================================================
# Revisor — AI Business-Aware PR Reviewer
# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# Keep real secrets (tokens, keys) out of THIS file — it is a shared template.
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# ---- Model provider ----------------------------------------------------------
# Which reviewer to use:
#   qwen      -> local Qwen3-Coder via an OpenAI-compatible server (DEFAULT, primary)
#   claude    -> Anthropic Claude (needs ANTHROPIC_API_KEY)
#   heuristic -> offline rule-based reviewer (no model, no network)
LLM_PROVIDER=qwen

LLM_MAX_TOKENS=8192
# Sampling temperature. Local models accept it (0 = deterministic reviews).
# Leave UNSET for current Anthropic Opus/Sonnet models — they reject it (400).
LLM_TEMPERATURE=0

# ---- Local Qwen3-Coder (primary; OpenAI-compatible) --------------------------
# Default targets Ollama. Setup:
#   OLLAMA_CONTEXT_LENGTH=16384 ollama serve   # REQUIRED — see note below
#   ollama pull qwen3-coder         # 30B, ~19GB — needs ~32GB RAM
#   ollama pull qwen2.5-coder:14b   # ~9GB — good on <=18GB RAM
#   ollama pull qwen2.5-coder:7b    # ~4.7GB — lightest
# REQUIRED: start Ollama with a large context. A review prompt is ~5-8K tokens;
# Ollama's default context (~2-4K) truncates the prompt and DROPS THE DIFF, so
# the model hallucinates and misses findings. Symptom: the review talks about
# files not in the diff. Set OLLAMA_CONTEXT_LENGTH=16384 on `ollama serve`.
# NOTE: use 127.0.0.1, not localhost — Node 18's fetch prefers IPv6 (::1) but
# Ollama listens on IPv4 only, so `localhost` fails with "fetch failed".
QWEN_BASE_URL=http://127.0.0.1:11434/v1
QWEN_MODEL=qwen3-coder
# Optional bearer token (some servers require a placeholder, e.g. "ollama").
QWEN_API_KEY=
# Other OpenAI-compatible servers work by changing QWEN_BASE_URL:
#   vLLM        -> http://127.0.0.1:8000/v1
#   llama.cpp   -> http://127.0.0.1:8080/v1
#   LM Studio   -> http://127.0.0.1:1234/v1

# ---- Anthropic / Claude (alternative provider; used when LLM_PROVIDER=claude) -
ANTHROPIC_API_KEY=
# The reviewer forces structured tool output, which pairs cleanly with Opus 4.8
# (thinking off by default). You may set claude-opus-5 or another current model.
LLM_MODEL=claude-opus-4-8
# Model used for the cheaper validation pass. Defaults to LLM_MODEL if unset.
LLM_VALIDATION_MODEL=

# ---- GitHub ------------------------------------------------------------------
# A fine-grained PAT or GitHub App installation token with LEAST privilege:
#   - Pull requests: Read & Write (to post reviews/comments)
#   - Contents: Read (to fetch file contents for context)
# Without a token the reviewer runs in dry-run mode (prints the review, no post).
GITHUB_TOKEN=
# Optional: only accept webhooks for these "owner/repo" slugs (comma-separated).
GITHUB_ALLOWED_REPOS=
# HMAC secret configured on the GitHub webhook. REQUIRED to accept webhooks.
GITHUB_WEBHOOK_SECRET=

# ---- Review policy -----------------------------------------------------------
# Findings below this confidence [0..1] are dropped entirely.
REVIEW_MIN_CONFIDENCE=0.55
# BLOCKER/IMPORTANT findings below this confidence are downgraded, not blocking.
REVIEW_BLOCKING_CONFIDENCE=0.8
# Cap on surfaced findings, to avoid overwhelming developers.
REVIEW_MAX_FINDINGS=15
# When true, the reviewer only comments and never auto-requests changes.
REVIEW_DRY_RUN=false

# ---- Context (retrieval for reviews) -----------------------------------------
CONTEXT_DOCS_DIR=docs/ai
CONTEXT_MAX_RESULTS=12

# ---- Context Evolution (learn from merged/reverted PRs) ----------------------
# Analyze merged PRs and evolve the AI's business/technical context.
CONTEXT_EVOLUTION_ENABLED=true
# Where the versioned context store is persisted (gitignored). Swap for a DB later.
CONTEXT_STORE_PATH=data/context-store.json
# confidence >= auto → applied automatically; [proposal, auto) → PENDING_REVIEW;
# < proposal → NO_CONTEXT_CHANGE.
CONTEXT_AUTO_UPDATE_THRESHOLD=0.90
CONTEXT_PROPOSAL_THRESHOLD=0.70
# Below this revert-detection confidence, a PR is not treated as a revert.
CONTEXT_REVERT_CONFIDENCE_THRESHOLD=0.60
# Optional safeguard: categories that ALWAYS require human review, even at high
# confidence (comma-separated). e.g. BUSINESS_RULE,SECURITY. Empty = auto-apply.
CONTEXT_REVIEW_REQUIRED_CATEGORIES=
